# Makefile for LEXGEN Library
#
# Targets:
#   all         - Build library and examples
#   lib         - Build static library
#   shared      - Build shared library
#   example     - Build C example
#   lua         - Build Lua extension
#   test        - Run tests
#   clean       - Remove build artifacts

CC = gcc
CFLAGS = -Wall -O2
LDFLAGS =

# Lua configuration
LUA_VERSION = 5.3
LUA_INCLUDE = /usr/include/lua$(LUA_VERSION)
LUA_LIB = -llua$(LUA_VERSION)

# Library files
LIB_SOURCES = lexgen.c
LIB_OBJECTS = $(LIB_SOURCES:.c=.o)
LIB_HEADERS = lexgen.h

# Output files
STATIC_LIB = liblexgen.a
SHARED_LIB = liblexgen.so
EXAMPLE_BIN = lexgen_example
LUA_MODULE = lexgen_lua.so

.PHONY: all lib shared example lua test clean install

all: lib example

# Static library
lib: $(STATIC_LIB)

$(STATIC_LIB): $(LIB_OBJECTS)
	ar rcs $@ $^
	@echo "Static library built: $@"

# Shared library
shared: $(SHARED_LIB)

$(SHARED_LIB): $(LIB_SOURCES)
	$(CC) $(CFLAGS) -fPIC -shared -o $@ $^
	@echo "Shared library built: $@"

# C example
example: $(EXAMPLE_BIN)

$(EXAMPLE_BIN): lexgen_example.c $(LIB_SOURCES) $(LIB_HEADERS)
	$(CC) $(CFLAGS) -o $@ lexgen_example.c $(LIB_SOURCES)
	@echo "Example built: $@"
	@echo "Run with: ./$(EXAMPLE_BIN)"

# Lua extension
lua: $(LUA_MODULE)

$(LUA_MODULE): lexgen_lua.c $(LIB_SOURCES) $(LIB_HEADERS)
	$(CC) $(CFLAGS) -fPIC -shared -o $@ lexgen_lua.c $(LIB_SOURCES) \
		-I$(LUA_INCLUDE) $(LUA_LIB)
	@echo "Lua module built: $@"
	@echo "Run demo with: lua$(LUA_VERSION) lexgen_demo.lua"

# Object files
%.o: %.c $(LIB_HEADERS)
	$(CC) $(CFLAGS) -c -o $@ $<

# Test targets
test: test-example test-lua

test-example: $(EXAMPLE_BIN)
	@echo "Running C example..."
	./$(EXAMPLE_BIN)
	@echo "✓ C example passed"

test-lua: $(LUA_MODULE)
	@echo "Running Lua demo..."
	@lua$(LUA_VERSION) lexgen_demo.lua
	@echo "✓ Lua demo passed"

# Install (optional)
PREFIX = /usr/local
INSTALL_LIB = $(PREFIX)/lib
INSTALL_INC = $(PREFIX)/include
INSTALL_LUA_CPATH = $(PREFIX)/lib/lua/$(LUA_VERSION)

install: lib shared lua
	mkdir -p $(INSTALL_LIB)
	mkdir -p $(INSTALL_INC)
	mkdir -p $(INSTALL_LUA_CPATH)
	cp $(STATIC_LIB) $(INSTALL_LIB)/
	cp $(SHARED_LIB) $(INSTALL_LIB)/
	cp $(LIB_HEADERS) $(INSTALL_INC)/
	cp $(LUA_MODULE) $(INSTALL_LUA_CPATH)/
	@echo "Installed to $(PREFIX)"

# Clean
clean:
	rm -f $(LIB_OBJECTS)
	rm -f $(STATIC_LIB) $(SHARED_LIB)
	rm -f $(EXAMPLE_BIN) $(LUA_MODULE)
	rm -f lexer_generated.c demo_lexer.c
	@echo "Cleaned build artifacts"

# Help
help:
	@echo "LEXGEN Library Makefile"
	@echo ""
	@echo "Targets:"
	@echo "  all         - Build static library and C example"
	@echo "  lib         - Build static library (liblexgen.a)"
	@echo "  shared      - Build shared library (liblexgen.so)"
	@echo "  example     - Build C example program"
	@echo "  lua         - Build Lua extension module"
	@echo "  test        - Run all tests"
	@echo "  test-example- Run C example test"
	@echo "  test-lua    - Run Lua demo test"
	@echo "  install     - Install library and headers"
	@echo "  clean       - Remove build artifacts"
	@echo "  help        - Show this help"
	@echo ""
	@echo "Configuration:"
	@echo "  LUA_VERSION = $(LUA_VERSION)"
	@echo "  LUA_INCLUDE = $(LUA_INCLUDE)"
	@echo "  PREFIX      = $(PREFIX)"
